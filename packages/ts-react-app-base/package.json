{
  "name": "ts-react-app-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/ts-react-lib.umd.js",
  "module": "dist/ts-react-lib.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ts-react-lib.es.js",
      "require": "./dist/ts-react-lib.umd.js"

    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
